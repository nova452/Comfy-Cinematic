# Required for renders and for the routing brain, unless you sign in from the
# header (the key you paste there is saved in .data/account.json and wins over
# this one). Without either, the app falls back to the deterministic local
# router (answers about this setup only).
# Create a key for a workspace with Router access:
# https://platform.comfy.org/profile/api-keys?onboarding=router
COMFY_API_KEY=

# Optional: the text model that decides answer-vs-image and writes the answers.
# Default: anthropic/claude-haiku-4-5-20251001
# Any anthropic/* or openai/* Router text model is supported.
# HARNESS_MODEL=openai/gpt-5-mini

# Optional: use a compatible Router endpoint instead of the public Comfy Router.
# COMFY_ROUTER_BASE_URL=https://api.comfy.org

# Optional: the ComfyUI this app should render workflows on. Setting this
# overrides both Deployment and Comfy Desktop in Manage account (the dialog
# then shows "Set via environment"). A self-hosted ComfyUI needs no key; a
# hosted deployment (dep-….run.comfy.app) takes the key saved in Manage account.
# COMFY_BASE_URL=http://127.0.0.1:8189
# COMFY_LOCAL_API_KEY=

# The local diffusion model, clip model and step count for MiniMax H3 come from
# the gear on the MiniMax H3 Local row in the video model picker (saved in
# .data/local-model.json). Openjutsu has its own gear and record for the same
# fields plus its OpenRouter key. H3_CLIP and H3_STEPS only fill gaps while
# neither record has been saved; the two VAEs are not in the dialogs, so they
# stay here:
# H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# H3_VAE_VIDEO=minimax_h3_video_vae_fp16.safetensors
# H3_VAE_AUDIO=minimax_h3_audio_vae_fp32.safetensors
# H3_STEPS=20

# The Openjutsu video model runs the ref6 graph on the same local H3 install:
# character sheets, a border check and a prompt model inside ComfyUI, all on
# OpenRouter. Its key and file names also live in its own gear, which wins.
# OPENROUTER_API_KEY=
# The second sampling pass's model and LoRA, if yours are named differently:
# H3_REF2VA_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# H3_REF2VA_LORA=pika_h3_flex_ref2va_v1_bf16.safetensors
# The upscale pass's latent upscaler (the refiner LoRA is found by Verify):
# H3_LATENT_UPSCALER=minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors

# The same split for FLUX 3. The gear on the FLUX 3 Local row in the image model
# picker saves the diffusion model, Qwen3-VL text encoder and steps in
# .data/local-image.json; FLUX_UNET / FLUX_CLIP / FLUX_STEPS only fill gaps while
# nothing has been saved. The VAE stays here:
# FLUX_UNET=flux3-image-klein-int8-convrot0.safetensors
# FLUX_CLIP=qwen3vl_4b_fp8_scaled.safetensors
# FLUX_VAE=flux2-vae.safetensors
# FLUX_STEPS=20

# The image tools are defined in lib/harness.ts (FLUX 3 on Router, FLUX 3 Local).
